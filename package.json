  "description": "Verkauf, Lieferung, Lager und Kasse für Filialbetriebe",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/src/index.ts",

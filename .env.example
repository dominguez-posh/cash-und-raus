# Lokale Entwicklung: Werte als Umgebungsvariablen setzen (die Datei .env wird nicht eingecheckt).
# Das erste Admin-Konto wird beim ersten Öffnen der App angelegt (Ersteinrichtung).

# Öffentliche Adresse (SAML Entity-ID und ACS-URL bauen darauf auf)
CR_PUBLIC_URL=http://localhost:3000
CR_PORT=3000
CR_DATA_DIR=data

# Schlüssel für Geheimnisse in der Datenbank (E-Mail: Graph-Client-Secret). In Azure setzt Terraform ihn.
# CR_SECRET_KEY=bitte-einen-langen-zufaelligen-wert-eintragen

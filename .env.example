# Lokale Entwicklung: kopieren nach .env (wird nicht eingecheckt) und mit
#   node --env-file=.env --import tsx server/src/index.ts
# bzw. npm run dev (liest die Variablen aus der Umgebung) starten.

# Erstes lokales Admin-Konto (nur solange noch keins existiert)
CR_ADMIN_USER=notfall
CR_ADMIN_PASSWORD=bitte-ein-langes-passwort-1

# Öffentliche Adresse (SAML Entity-ID und ACS-URL bauen darauf auf)
CR_PUBLIC_URL=http://localhost:3000
CR_PORT=3000
CR_DATA_DIR=data
